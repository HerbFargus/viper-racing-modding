# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# PyInstaller build output (root or under desktop/)
build/
dist/
*.manifest

# App settings written at runtime (per-user)
config.json

# Client-side gallery build artifact (regenerated by scripts/build_gallery.py
# from the canonical vrmod/, so it never drifts -- see that script)
gallery/vrmod.zip

# Game data -- NEVER commit copyrighted Viper Racing assets. The toolkit reads
# the user's own install; nothing game-derived belongs in this repo.
*.car
*.trk
*.tra
*.res
*.stp
race.bin

# Local scratch / prototype / test data
gallery-proto/
_testdata/

# OS / editor
.DS_Store
Thumbs.db
icon-preview.png
