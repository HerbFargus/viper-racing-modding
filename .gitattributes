# Files that run on Linux keep LF endings even in a Windows checkout
# (core.autocrlf would otherwise hand bash a CR at the end of every line).
*.sh text eol=lf
*.desktop text eol=lf
desktop/linux/AppRun text eol=lf

# The bundled Linux engine is copied byte for byte beside the game and checked against SOURCE.txt's
# sha256s: never convert its line endings (viperport.sh must stay LF to run; the ELF and .so are binaries).
# (After the *.sh rule, so it wins for viperport.sh.)
vrmod/assets/modern_engine/linux/** -text
vrmod/assets/modern_engine/linux/viperport binary
vrmod/assets/modern_engine/linux/lib/** binary
